$ORIGIN kako.org.
@   3600 IN SOA sns.dns.icann.org. noc.dns.icann.org. (
                2017042745 ; serial
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                3600       ; minimum
                )
    3600 IN NS a.iana-servers.net.
    3600 IN NS b.iana-servers.net.

@   3600 IN A 127.0.0.1
www 3600 IN A 127.0.0.1
