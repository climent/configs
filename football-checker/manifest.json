{
  "manifest_version": 3,
  "name": "Hay Fútbol?",
  "version": "1.0",
  "description": "Checks hayahora.futbol to see if there is soccer right now.",
  "permissions": ["alarms"],
  "host_permissions": ["https://hayahora.futbol/*"],
  "action": {
    "default_title": "Hay Fútbol?",
    "default_badge_text": "..."
  },
  "background": {
    "service_worker": "background.js"
  }
}
